function endCheck(){
  if(!g.game_over())return false;
  over=true;busy=false;let r=0,reason='';
  if(g.in_checkmate()){const w=g.turn()==='w'?'b':'w';r=w===me?1:-1;reason='Checkmate'}
  else if(g.in_stalemate()){r=0;reason='Stalemate'}
  else if(g.in_threefold_repetition()){r=0;reason='Repetition'}
  else if(g.insufficient_material()){r=0;reason='Insufficient material'}
  else if(g.in_draw()){r=0;reason='50-move rule'}
  fin(r);showEnd(r,reason);return true;
}
function fin(r){
  clearInterval(tmr);
  const al=hist.length?hist.reduce((a,x)=>a+Math.min(x.loss,600),0)/hist.length:0;
  const d=Math.max(-30,Math.min(45,Math.round(25-al/5)+(r>0?20:r<0?-10:0)));
  S.iq=Math.max(400,S.iq+d);S.games++;
  hist.forEach(x=>{if(x.loss>250){const p=x.n<20?'opening':x.n<60?'middlegame':'endgame';S.weak[p]=(S.weak[p]||0)+1}});save();
}
function showEnd(r,reason){
  const word=r>0?END_WIN():r<0?END_LOSE():END_DRAW();
  const sub=r>0?'You won':r<0?'You lost':'Draw';
  const blunders=gameMoves.filter(m=>m.loss>250).length;
  const best=gameMoves.filter(m=>m.loss!=null&&m.loss<=5).length;
  const nice=gameMoves.filter(m=>m.loss!=null&&m.loss>5&&m.loss<=50).length;
  $('#endword').textContent=word;$('#endsub').textContent=sub+' by '+reason;
  $('#endstats').innerHTML=`<div class="stat"><b>${best}</b><small>Best</small></div>
    <div class="stat"><b>${nice}</b><small>Good</small></div>
    <div class="stat"><b>${blunders}</b><small>Blunders</small></div>`;
  setFace(r>0?'win':r<0?'lose':'idle');
  if(r>0)say('win');else if(r<0)say('lose');else say('draw');
  const f=$('#fat');
  f.innerHTML=`<div class="f1">GAME</div><div class="f2" style="color:${r>0?'#4ade80':r<0?'#ef4444':'#facc15'}">${sub.toUpperCase()}</div>`;
  f.className='on';play(r>0?'gr':'bl');vib(r>=0?[80,40,80]:[200,80,200]);shake('bg');
  setTimeout(()=>{f.className='';$('#end').className='on'},1400);
}

  queen:[()=>{tone(90,30,.7,'sine',.5);noise(.5,.5,400)},()=>tone(70,25,.8,'sine',.55)],
  move:[()=>tone(560,300,.06,'sine',.18),()=>tone(500,280,.06,'sine',.2),()=>tone(620,320,.05,'triangle',.16)],

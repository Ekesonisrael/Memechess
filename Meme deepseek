function ev(c){let s=0;const b=c.board();for(let i=0;i<8;i++)for(let j=0;j<8;j++){const p=b[i][j];if(!p)continue;let v=V[p.type]+(7-Math.abs(i-3.5)-Math.abs(j-3.5))*(p.type==='p'||p.type==='n'?4:1);s+=p.color==='w'?v:-v}return s}
function nm(c,d,a,b){if(c.in_checkmate())return c.turn()==='w'?-99999-d:99999+d;if(c.game_over())return 0;if(d===0)return ev(c);
  const w=c.turn()==='w',ms=c.moves({verbose:true}).sort((x,y)=>(y.captured?V[y.captured]:0)-(x.captured?V[x.captured]:0));let best=w?-1e9:1e9;
  for(const m of ms){c.move(m);const s=nm(c,d-1,a,b);c.undo();if(w){best=Math.max(best,s);a=Math.max(a,s)}else{best=Math.min(best,s);b=Math.min(b,s)}if(b<=a)break}return best}
function pick(c,d,nz=0){const w=c.turn()==='w';let best=null,bs=w?-1e9:1e9;
  for(const m of c.moves({verbose:true})){c.move(m);const s=nm(c,d-1,-1e9,1e9)+(Math.random()-.5)*nz;c.undo();if(w?s>bs:s<bs){bs=s;best=m}}return{m:best,s:bs}}
const lvl=e=>e<700?{d:1,n:500}:e<1000?{d:1,n:250}:e<1300?{d:2,n:200}:e<1600?{d:2,n:60}:e<1900?{d:3,n:15}:{d:3,n:0};
const eloName=e=>e<700?'Newbie':e<1000?'Beginner':e<1300?'Casual':e<1600?'Club player':e<1900?'Strong':'Hard';

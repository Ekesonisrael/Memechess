<!DOCTYPE html><html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
<meta name="theme-color" content="#08040e">
<title>MemeChess</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/chess.js/0.10.3/chess.min.js"></script>
<style>
:root{--bg:#08040e;--fg:#f2f2f2;--card:#1a1226;--ac:#a855f7;--lt:#7c3aed;--dk:#0a0416}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{height:100%}
body{margin:0;background:var(--bg);color:var(--fg);font:16px/1.4 system-ui,-apple-system,sans-serif;display:flex;flex-direction:column;min-height:100vh;overflow-x:hidden}
.scr{display:none;flex:1;padding:12px;max-width:560px;margin:0 auto;width:100%}
.scr.on{display:flex;flex-direction:column;animation:slidein .28s ease-out}
@keyframes slidein{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
@keyframes fadein{from{opacity:0}to{opacity:1}}
@keyframes pop{from{transform:scale(.7);opacity:0}to{transform:scale(1);opacity:1}}
@keyframes qpop{from{transform:scale(.3);opacity:0}to{transform:scale(1);opacity:1}}
@keyframes blinkfade{0%{opacity:1}60%{opacity:1}100%{opacity:0}}
@keyframes dotpulse{50%{transform:scale(1.15)}}
@keyframes cappulse{50%{box-shadow:0 0 30px 12px rgba(239,68,68,1),inset 0 0 22px 8px rgba(239,68,68,.95)}}
@keyframes checkpulse{0%,100%{box-shadow:inset 0 0 0 3px #ef4444,inset 0 0 22px 6px rgba(239,68,68,.75)}50%{box-shadow:inset 0 0 0 3px #ff2a2a,inset 0 0 32px 12px rgba(239,68,68,1)}}
@keyframes bannerin{from{opacity:0;transform:translateY(-10px)}to{opacity:1;transform:translateY(0)}}
@keyframes msgin{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}
@keyframes sl{from{transform:scale(4);opacity:0}to{transform:scale(1);opacity:1}}
@keyframes qbump{from{transform:scale(.4);opacity:0}to{transform:scale(1);opacity:1}}
@keyframes checkbadge{from{transform:translate(-50%,-10px);opacity:0}to{transform:translate(-50%,0);opacity:1}}
h1{font:900 clamp(32px,10vw,44px) Impact,sans-serif;text-align:center;margin:16px 0 4px;color:var(--ac);letter-spacing:1px;animation:pop .5s}
.sub{text-align:center;opacity:.6;margin-bottom:20px;font-size:14px}
button,input,select{font:inherit}
.btn{display:block;width:100%;padding:15px 16px;margin:8px 0;border:0;border-radius:12px;background:var(--card);color:var(--fg);font-weight:700;text-align:left;cursor:pointer}
.btn:active{transform:scale(.97)}
.btn.p{background:var(--ac);color:#fff;text-align:center;font-size:19px;border-bottom:4px solid #7e22ce}
.btn.g{background:#16a34a;color:#fff;text-align:center;font-size:18px;border-bottom:4px solid #15803d}
.top{display:flex;align-items:center;gap:10px;font-weight:700;font-size:18px;margin-bottom:10px}
.top button{background:none;border:0;color:var(--fg);font-size:26px;padding:0 6px;cursor:pointer}
.seg{display:flex;gap:6px;margin:10px 0}
.seg button{flex:1;padding:12px;border-radius:10px;border:2px solid transparent;background:var(--card);color:var(--fg);font-weight:700;cursor:pointer}
.seg .on{border-color:var(--ac)}
.row{display:flex;justify-content:space-between;align-items:center;background:var(--card);padding:12px;border-radius:12px;margin:8px 0}
input[type=range]{width:100%;accent-color:var(--ac);height:30px}
.big{font-size:20px;font-weight:800;text-align:center;padding:4px 0}
#ev{height:22px;background:#3a2a4a;border-radius:4px;overflow:hidden;position:relative;margin:4px 0}
#evf{height:100%;background:#e8e8ee;width:50%;transition:width .4s}
#evt{position:absolute;right:8px;top:0;font-weight:700;color:#111;font-size:13px;line-height:22px}
#coach{display:flex;gap:10px;align-items:flex-start;margin:6px 0}
#face{width:60px;height:60px;flex:none;border-radius:50%;background:#fff;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,.4)}
#face svg{display:block;width:100%;height:100%}
#ct{background:#fff;color:#1a1226;padding:10px 14px;border-radius:14px;flex:1;font-size:14px;min-height:44px;display:flex;align-items:center;box-shadow:0 2px 6px rgba(0,0,0,.3)}
#ct.flash{animation:msgin .3s}
#log{max-height:0;overflow:hidden;font-size:13px;margin:0;transition:max-height .25s}
#log.open{max-height:180px;overflow-y:auto;margin:6px 0}
#log div{padding:5px 10px;margin:3px 0;border-radius:10px;background:#1a1226}
#log .u{background:var(--ac);text-align:right;color:#fff}
#logbtn{background:none;border:0;color:#9a9a9a;font-size:12px;padding:2px 6px;cursor:pointer;align-self:flex-start}
.clk{display:flex;justify-content:space-between;font-weight:700;margin:4px 0;font-size:14px}
.clk b{background:#241a33;padding:3px 10px;border-radius:6px;font-variant-numeric:tabular-nums}
/* Opening name — always visible above board */
#opname{
  display:none;
  background:linear-gradient(90deg,#1e1b4b,#312e81,#1e1b4b);
  color:#fde68a;padding:8px 14px;border-radius:10px;margin:6px 0;
  font-size:13px;font-weight:800;letter-spacing:.5px;
  border-left:4px solid #facc15;
  box-shadow:0 2px 12px rgba(168,85,247,.35);
}
#opname.on{display:block;animation:bannerin .35s}
#opname .icon{opacity:.9;margin-right:6px}
#bdwrap{position:relative;border-radius:10px;overflow:hidden;background:#000;aspect-ratio:1;width:100%;max-width:min(92vw,480px);margin:0 auto;box-shadow:0 6px 24px rgba(168,85,247,.35)}
#bd{display:grid;grid-template-columns:repeat(8,1fr);grid-template-rows:repeat(8,1fr);width:100%;height:100%;user-select:none;touch-action:manipulation}
.sq{position:relative;display:flex;align-items:center;justify-content:center;overflow:hidden}
.sq svg{width:96%;height:96%;display:block;z-index:3;filter:drop-shadow(0 1px 1px rgba(0,0,0,.55))}
.sq.lm::after{content:"";position:absolute;inset:0;background:rgba(250,204,21,.5);pointer-events:none;z-index:1}
.sq.ht::after{content:"";position:absolute;inset:0;background:rgba(34,197,94,.6);pointer-events:none;z-index:1}
.sq.blunder::after{content:"";position:absolute;inset:0;background:rgba(239,68,68,.85);pointer-events:none;animation:blinkfade 1.6s forwards;z-index:1}
.sq.incheck::after{content:"";position:absolute;inset:0;background:radial-gradient(circle,rgba(239,68,68,.4) 0%,rgba(239,68,68,0) 70%);pointer-events:none;z-index:1}
.sq.incheck{animation:checkpulse 1.1s ease-in-out infinite}
.sq .checkbadge{position:absolute;top:4px;left:50%;transform:translateX(-50%);background:#ef4444;color:#fff;font-weight:900;font-size:11px;padding:2px 8px;border-radius:10px;z-index:5;letter-spacing:1px;box-shadow:0 0 10px rgba(239,68,68,.9);animation:checkbadge .4s}
.sq .qbadge{position:absolute;top:3px;right:3px;font-weight:900;font-size:14px;padding:2px 8px;border-radius:10px;z-index:6;box-shadow:0 0 0 2px rgba(0,0,0,.85);animation:qbump .3s}
.qbadge.q-blunder{background:#dc2626;color:#fff}
.qbadge.q-mistake{background:#ea580c;color:#fff}
.qbadge.q-inacc{background:#eab308;color:#111}
.qbadge.q-good{background:#22c55e;color:#052e16}
.qbadge.q-best{background:#0ea5e9;color:#fff}
.sq.sel{outline:4px solid #facc15;outline-offset:-4px;z-index:4}
.sq .mvdot{width:36%;height:36%;border-radius:50%;background:radial-gradient(circle at 35% 35%,#fff,#e9d5ff 60%,#a855f7 100%);box-shadow:0 0 0 3px #1a0b2e,0 0 16px 5px rgba(168,85,247,.95);position:absolute;z-index:2;animation:dotpulse 1.4s ease-in-out infinite}
.sq.cap::before{content:"";position:absolute;inset:4%;border-radius:50%;border:5px solid #ef4444;box-shadow:0 0 20px 6px rgba(239,68,68,.9),inset 0 0 16px 4px rgba(239,68,68,.6);z-index:2;pointer-events:none;animation:cappulse 1.2s ease-in-out infinite}
.sq[data-r]::before{content:attr(data-r);position:absolute;top:0;left:3px;font-size:10px;opacity:.55;color:#000;z-index:2}
.sq[data-f]::after{content:attr(data-f);position:absolute;bottom:0;right:4px;font-size:10px;opacity:.55;color:#000;z-index:2}
.sq.dk[data-r]::before,.sq.dk[data-f]::after{color:#ccc}
.sh{animation:sh .35s}.bg{animation:sh .6s}
@keyframes sh{20%{transform:translate(-6px,3px)}40%{transform:translate(6px,-4px)}60%{transform:translate(-4px,-3px)}80%{transform:translate(4px,3px)}}
#ml{display:flex;gap:6px;overflow-x:auto;padding:8px 0;white-space:nowrap;scrollbar-width:thin}
#ml span{background:var(--card);padding:4px 8px;border-radius:6px;font-weight:700;font-size:13px}
#ml .q{color:#f87171}
#bar{display:flex;justify-content:space-around;margin-top:6px}
#bar button{background:none;border:0;color:#bbb;font-weight:700;padding:8px 4px;font-size:13px;cursor:pointer}
#opt{position:fixed;top:12px;right:12px;z-index:10;background:var(--card);border:0;color:var(--fg);width:38px;height:38px;border-radius:50%;font-size:22px;font-weight:900;line-height:1;cursor:pointer;box-shadow:0 2px 8px rgba(0,0,0,.4)}
#optpanel{display:none;position:fixed;top:58px;right:12px;z-index:11;background:#241a33;border-radius:12px;padding:6px;min-width:200px;box-shadow:0 8px 24px rgba(0,0,0,.6)}
#optpanel.on{display:block;animation:slidein .15s}
#optpanel button{display:block;width:100%;text-align:left;background:none;border:0;color:var(--fg);padding:12px 14px;font-weight:700;border-radius:8px;font-size:14px;cursor:pointer}
#optpanel button:active{background:#3a2a4a}
#tp{display:none;background:var(--ac);padding:8px;border-radius:8px;font-weight:700;margin:6px 0;color:#fff;text-align:center;font-size:14px}
.tr #tp{display:block}
.tr #ev,.tr .pl,.tr #ml,.tr #opname{display:none!important}
#chatwrap{margin:8px 0}
#qr{display:flex;gap:6px;background:#1a1226;border-radius:12px;padding:5px 8px}
#qr input{flex:1;background:none;border:0;color:inherit;outline:0;padding:8px 4px;font-size:14px;min-width:0}
#qr button{background:var(--ac);color:#fff;border:0;border-radius:8px;padding:8px 14px;font-weight:700;cursor:pointer;font-size:13px}
#end{display:none;position:fixed;inset:0;z-index:20;background:rgba(0,0,0,.88);align-items:center;justify-content:center;padding:16px}
#end.on{display:flex;animation:fadein .3s}
#endcard{background:#1a1226;border-radius:16px;padding:22px;max-width:420px;width:100%;text-align:center;max-height:90vh;overflow-y:auto;animation:slidein .4s}
#endword{font:900 clamp(28px,8vw,40px) Impact,sans-serif;color:#facc15;margin-bottom:8px;animation:pop .55s}
#endsub{opacity:.9;margin-bottom:16px;font-size:15px}
#endstats{display:flex;justify-content:space-around;margin:16px 0;gap:8px}
.stat{text-align:center;flex:1}
.stat b{display:block;font-size:26px;color:var(--ac)}
.stat small{opacity:.6;font-size:10px;text-transform:uppercase}
#endbtns{display:flex;flex-direction:column;gap:8px;margin-top:8px}
#endbtns button{padding:14px;border-radius:12px;border:0;font-weight:800;background:var(--ac);color:#fff;cursor:pointer;font-size:15px}
#endbtns button.sec{background:#2a2733;color:var(--fg)}
#endbtns button.g{background:#16a34a}
#fat{display:none;position:fixed;inset:0;z-index:30;background:rgba(0,0,0,.97);color:#fff;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:20px}
#fat.on{display:flex}
.f1{font:900 clamp(40px,13vw,90px) Impact,sans-serif;color:#facc15}
.f2{font:900 clamp(48px,16vw,110px) Impact,sans-serif;animation:sl .55s}
#review{display:none;flex-direction:column}
#review.on{display:flex}
#rboard{position:relative;border-radius:10px;overflow:hidden;background:#000;aspect-ratio:1;width:100%;max-width:min(92vw,480px);margin:0 auto}
#rbd{display:grid;grid-template-columns:repeat(8,1fr);grid-template-rows:repeat(8,1fr);width:100%;height:100%}
#rbd .sq{display:flex;align-items:center;justify-content:center;position:relative}
#rarrow{position:absolute;inset:0;pointer-events:none;z-index:10}
#rnav{display:flex;gap:8px;justify-content:center;margin:12px 0}
#rnav button{background:var(--ac);color:#fff;border:0;border-radius:10px;padding:11px 22px;font-weight:800;cursor:pointer;font-size:14px}
#rnav button:disabled{opacity:.35;cursor:default}
#rcomment{background:#fff;color:#1a1226;padding:12px 16px;border-radius:14px;min-height:56px;font-size:14px;margin:8px 0;display:flex;align-items:center;line-height:1.35}
.card{background:var(--card);border-radius:14px;padding:14px;margin:8px 0}
.card h3{margin:0 0 6px;font-size:16px}
.card p{margin:0;opacity:.7;font-size:13px}
.progbar{height:8px;background:#2a2733;border-radius:4px;overflow:hidden;margin:10px 0}
.progbar>div{height:100%;background:var(--ac);transition:width .3s}
.drillrow{display:flex;gap:8px;margin-top:8px}
.drillrow button{flex:1;padding:10px;border-radius:10px;border:0;background:var(--ac);color:#fff;font-weight:700;cursor:pointer;font-size:14px}
.drillrow button.sec{background:#2a2733;color:var(--fg)}
.swatch{display:flex;align-items:center;gap:12px;background:var(--card);padding:10px 14px;border-radius:12px;margin:8px 0}
.swatch input[type=color]{width:48px;height:34px;border:0;background:none;border-radius:6px;padding:0;cursor:pointer}
.swatch label{flex:1;font-weight:600;font-size:14px}
small{opacity:.6}
</style></head><body>


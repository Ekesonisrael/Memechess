function leave(){clearInterval(tmr);over=true;show('menu')}

function prog(){
  const w=Object.entries(S.weak).sort((a,b)=>b[1]-a[1]).map(e=>e[0]+' ('+e[1]+')').join(', ')||'none yet';
  $('#pg').innerHTML=`<div class="row"><span>Chess IQ</span><b>${S.iq}</b></div>
    <div class="row"><span>Games played</span><b>${S.games}</b></div>
    <div class="row"><span>Weak spots</span><b>${w}</b></div>`;
  show('progs');
}

/* ============ TRAINING ============ */
const DRILLS=[
  {id:'sq',name:'Name the Square',desc:'Tap the square called out.'},
  {id:'pieces',name:'Piece Recognition',desc:'Find the named piece on the board.'},
  {id:'atk',name:'Attacked Squares',desc:'Tap every square your piece attacks.'},
  {id:'mate',name:'Mate in 1',desc:'Find the checkmate in one move.'}
];
function drillProgress(id){S.training[id]=S.training[id]||{done:0,streak:0,best:0};return S.training[id]}
function openTrain(){
  $('#tlist').innerHTML=DRILLS.map(d=>{const p=drillProgress(d.id);
    return `<div class="card"><h3>${d.name}</h3><p>${d.desc}</p>
      <div class="progbar"><div style="width:${Math.min(100,p.done*5)}%"></div></div>
      <div style="font-size:12px;opacity:.7">${p.done} solved · best streak ${p.best}</div>
      <div class="drillrow">
        <button onclick="startDrill('${d.id}')">${p.done?'Continue':'Start'}</button>
        <button class="sec" onclick="resetDrill('${d.id}')">Reset</button>
      </div></div>`}).join('');
  show('trainmenu');
}
function resetDrill(id){if(!confirm('Reset this drill?'))return;S.training[id]={done:0,streak:0,best:0};save();openTrain()}
function startDrill(id){
  ac();
  mode=id;over=false;busy=false;sel=null;tgt=[];hint=null;flash={};fl=false;me='w';
  clearInterval(tmr);
  $('#game').classList.add('tr');show('game');
  const p=drillProgress(id);streak=p.streak;
  if(id==='sq'){g=new Chess();g.clear();nextSq()}
  else if(id==='pieces')loadPieceDrill();
  else if(id==='atk')loadAtkDrill();
  else if(id==='mate')loadMate();
  render();
}
function nextSq(){const p=drillProgress('sq');
  tsq='abcdefgh'[Math.random()*8|0]+(1+Math.random()*8|0);
  $('#tp').textContent='Tap '+tsq.toUpperCase()+' · streak '+streak+' · '+p.done+'/20';
  sel=null;tgt=[];}
function trainSq(n){const p=drillProgress('sq');flash={};
  if(n===tsq){p.done++;streak++;p.streak=streak;p.best=Math.max(p.best,streak);save();flash[n]='blunder';play('gr');setFace('good');cs('Nice.')}
  else{p.done=Math.max(0,p.done);streak=0;p.streak=0;save();flash[n]='blunder';flash[tsq]='blunder';play('bl');setFace('mistake');cs('That was '+tsq.toUpperCase()+'.')}
  render();setTimeout(()=>{flash={};nextSq();render()},900);}
function loadPieceDrill(){g=new Chess();g.clear();
  const types=['p','n','b','r','q'];const t=types[Math.random()*types.length|0];
  const sq='abcdefgh'[Math.random()*8|0]+(1+Math.random()*8|0);
  g.put({type:t,color:Math.random()<.5?'w':'b'},sq);
  window._pieceTarget={type:t,sq};
  $('#tp').textContent='Tap the '+{p:'pawn',n:'knight',b:'bishop',r:'rook',q:'queen'}[t]+' · streak '+streak;
  sel=null;tgt=[];}
function trainPiece(n){const pt=window._pieceTarget;if(!pt)return;
  const p=g.get(n);const ok=p&&p.type===pt.type;const d=drillProgress('pieces');flash={};
  if(ok){d.done++;streak++;d.streak=streak;d.best=Math.max(d.best,streak);save();flash[n]='blunder';play('gr');setFace('good')}
  else{streak=0;d.streak=0;save();flash[n]='blunder';if(pt.sq)flash[pt.sq]='blunder';play('bl');setFace('mistake')}
  render();setTimeout(()=>{flash={};loadPieceDrill();render()},900);}
function loadAtkDrill(){g=new Chess();g.clear();
  const types=['n','b','r','q'];const t=types[Math.random()*types.length|0];
  const sq='abcdefgh'[Math.random()*8|0]+(1+Math.random()*8|0);
  g.put({type:t,color:'w'},sq);
  const targets=g.moves({square:sq,verbose:true}).map(m=>m.to);
  window._atkTarget={type:t,sq,found:new Set(),all:new Set(targets)};
  $('#tp').textContent='Tap ALL squares your '+{n:'knight',b:'bishop',r:'rook',q:'queen'}[t]+' attacks · streak '+streak;
  sel=sq;tgt=[...targets];}
function trainAtk(n){const A=window._atkTarget;if(!A)return;flash={};
  if(A.all.has(n)){A.found.add(n);flash[n]='blunder';play('mv')}
  else{flash[n]='blunder';play('bl');setFace('mistake');render();setTimeout(()=>{flash={};render()},600);return}
  render();
  if(A.found.size===A.all.size){
    const d=drillProgress('atk');d.done++;streak++;d.streak=streak;d.best=Math.max(d.best,streak);save();
    setFace('great');play('gr');
    setTimeout(()=>{flash={};loadAtkDrill();render()},900);}}
const MT=["6k1/5ppp/8/8/8/8/5PPP/R5K1 w - - 0 1","r1bqkbnr/pppp1ppp/2n5/4p2Q/2B1P3/8/PPPP1PPP/RNB1K1NR w KQkq - 0 1","7k/5Q2/6K1/8/8/8/8/8 w - - 0 1","6rk/6pp/8/6N1/8/8/8/6K1 w - - 0 1","8/8/8/8/8/1k6/8/K1R5 w - - 0 1"];
function loadMate(){const p=drillProgress('mate');mi=p.done%MT.length;
  g=new Chess(MT[mi]);sel=null;tgt=[];last=null;hint=null;
  $('#tp').textContent='Find mate in 1 · streak '+streak+' · '+p.done+' solved';}
function trainMate(f,t){const m=g.move({from:f,to:t,promotion:'q'});if(!m)return;
  sel=null;tgt=[];
  if(g.in_checkmate()){
    const d=drillProgress('mate');d.done++;streak++;d.streak=streak;d.best=Math.max(d.best,streak);save();
    fx(m);render();setFace('great');say('great');
    setTimeout(()=>{loadMate();render()},1400);
  }else{g.undo();streak=0;const d=drillProgress('mate');d.streak=0;save();
    play('bl');setFace('mistake');$('#tp').textContent='Find mate in 1 · streak 0';render();}}

eloLab();
(function initTheme(){
  const t=S.theme;$('#c-lt').value=t.lt;$('#c-dk').value=t.dk;
  document.documentElement.style.setProperty('--lt',t.lt);
  document.documentElement.style.setProperty('--dk',t.dk);
})();
</script>
</body></html>

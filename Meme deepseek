/* Look up opening name by current move history (SAN array) */
function lookupOpening(hist){
  if(!hist.length) return null;
  // Try longest match: start from hist.length, go shorter
  for(let len=hist.length;len>=1;len--){
    const seq=hist.slice(0,len).map(s=>s.replace(/[+#?!]/g,'')).join(' ');
    if(OPENING_DB[seq]) return {name:OPENING_DB[seq],depth:len};
  }
  return null;
}


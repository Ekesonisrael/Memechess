let rIdx=0;
function startReview(){
  closeEnd();
  if(!gameMoves.length){show('game');return}
  rIdx=0;rStep(0);show('review');
}
function explainMove(mv){
  if(mv.loss==null)return 'Opponent move.';
  if(mv.loss>250){return mv.best&&mv.best!==mv.san?"Blunder. Better was "+mv.best+".":"Blunder.";}
  if(mv.loss>120)return "Mistake. Better was "+(mv.best||'something else')+".";
  if(mv.loss>50)return "Inaccuracy.";
  if(mv.loss<=5&&mv.captured)return "Best move. Clean capture.";
  if(mv.loss<=5)return "Best move.";
  return "Solid.";
}
function rStep(delta){
  if(delta)rIdx=Math.max(0,Math.min(gameMoves.length-1,rIdx+delta));
  const mv=gameMoves[rIdx];if(!mv)return;
  const c=new Chess(mv.fenAfter);const bd=c.board();const B=$('#rbd');B.innerHTML='';const t=S.theme;
  for(let r=0;r<8;r++)for(let cc=0;cc<8;cc++){
    const p=bd[r][cc],n='abcdefgh'[cc]+(8-r),d=document.createElement('div');
    const dark=(r+cc)%2;d.className='sq '+(dark?'dk':'lt');d.style.background=dark?t.dk:t.lt;
    if(p)d.innerHTML=PIECE_SVG(p.type,p.color);
    if(mv.loss>250&&mv.to===n){d.classList.add('blunder');const b=document.createElement('span');b.className='badge';b.textContent='??';d.appendChild(b)}
    B.appendChild(d);
  }
  const line=$('#rline');
  if(mv.loss>250&&mv.best&&mv.fenBefore){
    try{
      const before=new Chess(mv.fenBefore);
      const legal=before.moves({verbose:true});
      const chosen=legal.find(x=>x.san.replace(/[+#?!]/g,'')===mv.best.replace(/[+#?!]/g,''));
      if(chosen){
        const fileToX=f=>('abcdefgh'.indexOf(f)+.5)*12.5;
        const rankToY=r=>(8-r+.5)*12.5;
        line.setAttribute('x1',fileToX(chosen.from[0]));
        line.setAttribute('y1',rankToY(+chosen.from[1]));
        line.setAttribute('x2',fileToX(chosen.to[0]));
        line.setAttribute('y2',rankToY(+chosen.to[1]));
        line.setAttribute('opacity','1');
      } else line.setAttribute('opacity','0');
    }catch(e){line.setAttribute('opacity','0')}
  } else line.setAttribute('opacity','0');
  $('#rcomment').textContent=`${rIdx+1}/${gameMoves.length} · ${mv.san} — ${explainMove(mv)}`;
  $('#rprev').disabled=rIdx===0;
  $('#rnext').disabled=rIdx>=gameMoves.length-1;
}

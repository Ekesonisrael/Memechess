const fmt=s=>(s/60|0)+':'+('0'+(s%60|0)).slice(-2);
function clocks(){$('#ck0').textContent=fmt(clk[0]);$('#ck1').textContent=fmt(clk[1])}
function tick(){if(mode!=='play'||over||!cfg.timer)return;const k=g.turn()===me?0:1;clk[k]--;clocks();
  if(clk[k]<=0){over=true;say(k===0?'lose':'win');play('bl');fin(k===0?-1:1);showEnd(k===0?-1:1,'Time')}}

function tap(n){
  ac();
  if(mode==='sq'){trainSq(n);return}
  if(mode==='pieces'){trainPiece(n);return}
  if(mode==='atk'){trainAtk(n);return}
  if(mode==='opening'){openingTap(n);return}
  if(mode==='mate'){if(sel&&tgt.includes(n)){trainMate(sel,n);return}
    const p=g.get(n);if(p&&p.color==='w'){sel=n;tgt=g.moves({square:n,verbose:true}).map(m=>m.to)}else{sel=null;tgt=[]}render();return}
  if(over||busy||g.turn()!==me)return;
  if(sel&&tgt.includes(n)){
    const piece=g.get(sel);const toRank=+n[1];
    if(piece&&piece.type==='p'&&((piece.color==='w'&&toRank===8)||(piece.color==='b'&&toRank===1))){askPromotion(sel,n);return}
    mv(sel,n);return;
  }
  const p=g.get(n);
  if(p&&p.color===me){sel=n;tgt=g.moves({square:n,verbose:true}).map(m=>m.to)}
  else{sel=null;tgt=[]}
  render();
}
function mv(f,t){
  const f0=g.fen();sel=null;tgt=[];hint=null;
  const pre=pick(new Chess(f0),2);
  const promoPiece=window._promo||'q';window._promo=null;
  const m=g.move({from:f,to:t,promotion:promoPiece});if(!m)return;
  const s=nm(g,2,-1e9,1e9),loss=Math.max(0,me==='w'?pre.s-s:s-pre.s),k=g.history().length-1;
  hist.push({san:m.san,best:pre.m?pre.m.san:'',loss,n:k+1});
  gameMoves.push({san:m.san,loss,fenBefore:f0,fenAfter:g.fen(),from:f,to:t,captured:m.captured||null,best:pre.m?pre.m.san:'',by:'user'});

  // ── OPENING PHASE LOGIC ──
  // Was this move a book move? (i.e. does it match an opening in the DB?)
  const hist2=g.history();
  const beforeName=currentOpeningName;
  const found=refreshOpeningName();
  // Move is "book" if the DB name advanced or the same name was extended
  const wasBook=!!found;
  const isOpening=hist2.length<=12;

  // Quality badge — only meaningful outside opening. In the opening, we don't penalize.
  let tag='',badge=null;
  if(isOpening&&wasBook){
    // Book move — praise, no eval judgement
    tag='';badge='good';
  } else if(isOpening&&!wasBook){
    // Off-book but still opening — don't punish unless it's a clear material blunder
    if(loss>300){tag='??';badge='blunder'}
    else if(loss>200){tag='?';badge='mistake'}
    else{tag='';badge=null}
  } else {
    // Middlegame — normal judgement
    if(loss>250){tag='??';badge='blunder'}
    else if(loss>120){tag='?';badge='mistake'}
    else if(loss>50){tag='?!';badge='inacc'}
    else if(loss<=5&&m.captured){tag='!';badge='best'}
    else if(loss<=5){tag='';badge='best'}
    else{tag='';badge='good'}
  }
  tags[k]=tag;
  qualityBadgeOn=m.to;qualityBadgeText=badge;

  clk[0]+=cfg.inc;clocks();
  fx(m);render();
  if(loss>250&&!isOpening)flashOnce(m.to,'blunder');
  if(endCheck())return;

  const pattern=detectPattern(f0,g.fen(),m,me);
  const extra=[];
  if(pattern.hanging.length)extra.push('You left enemy pieces hanging: '+pattern.hanging.join(', '));
  if(pattern.isCap)extra.push('You captured on '+m.to);
  if(pattern.isCheck)extra.push('You gave check');
  if(wasBook)extra.push('This was a book move of '+currentOpeningName);
  else if(isOpening&&currentOpeningName)extra.push('Off-book. We were in '+currentOpeningName);
  const extraStr=extra.join('. ');

  // Fire-and-forget coach reaction — NEVER blocks the game
  (async()=>{
    // Priority 1: state reactions (check, threat)
    const ctx=gameContext();
    if(ctx.myKingInCheck){setFace('panic');facePulse();
      const t=await ask('check',null,'Your OWN king is in check. Panic.');
      out((t||R.myCheck()).trim(),'check');return}
    if(ctx.yourKingInCheck){setFace('check');facePulse();
      const t=await ask('check',null,'User king in check.');
      out((t||R.check()).trim(),'check');return}

    // Priority 2: opening context
    if(wasBook&&isOpening){
      const isNewName=beforeName!==currentOpeningName;
      setFace('good');facePulse();
      if(isNewName){
        // Just entered a named opening
        const t=await ask('good',null,'Book move. New opening: '+currentOpeningName);
        const fb=R.bookIntro().replace('{OP}',currentOpeningName);
        out((t||fb).trim(),'good');
      } else if(Math.random()<.4){
        // Occasional praise for staying in book
        const t=await ask('good',null,'Book move in '+currentOpeningName);
        out((t||R.bookPraise()).trim(),'good');
      }
      return;
    }
    if(isOpening&&!wasBook&&currentOpeningName){
      const t=await ask('idle',null,'Off-book. Was in '+currentOpeningName);
      out((t||R.offBook()).trim(),'mistake');return;
    }

    // Priority 3: middlegame commentary (only on real blunders/mistakes)
    if(loss>250){play('bl');say('blunder',null,extraStr);vib([100,50,100]);return}
    if(loss>120){say('mistake',null,extraStr);return}
    if(tag==='!'){play('gr');say('great',null,extraStr);return}
    if(m.captured&&Math.random()<.3){say('capture',null,extraStr);return}
    // Otherwise, silent (or 15% chance of light good line)
    if(Math.random()<.15)say('good',null,extraStr);
  })();

  busy=true;
  setTimeout(bot,700);
}
function bot(){
  if(over)return;
  const L=lvl(cfg.elo),r=pick(g,L.d,L.n);
  if(r.m){
    const before=g.fen();
    const m=g.move(r.m);
    gameMoves.push({san:m.san,by:'bot',fenBefore:before,fenAfter:g.fen(),from:m.from,to:m.to,captured:m.captured||null,loss:null});
    clk[1]+=cfg.inc;
    fx(m);
    qualityBadgeOn=m.to;
    qualityBadgeText=m.captured?'best':'good';
    // Update opening name (bot move may extend book)
    refreshOpeningName();
  }
  busy=false;render();clocks();
  if(endCheck())return;
  setTimeout(async()=>{
    const ctx=gameContext();
    if(ctx.myKingInCheck){setFace('panic');facePulse();
      const t=await ask('check',null,'Your OWN king is in check. Panic.');
      out((t||R.myCheck()).trim(),'check');return}
    if(ctx.yourKingInCheck){setFace('check');facePulse();
      const t=await ask('check',null,'User king in check.');
      out((t||R.check()).trim(),'check');return}
    if(Math.random()<.15){const t=await ask('idle',null,'You just moved.');out((t||R.good()).trim(),'good')}
  },100);
}
function undo(){if(!cfg.undo||busy||over)return;const n=g.turn()===me?2:1;
  for(let i=0;i<n;i++)g.undo();hist.pop();gameMoves.splice(-n,n);busy=false;hint=null;last=null;
  qualityBadgeOn=null;qualityBadgeText=null;
  refreshOpeningName();render();cs('Rewound. Try again.');}
function hintBtn(){
  if(mode==='play'){if(!cfg.hints||over||busy)return;const r=pick(g,2).m;if(!r)return;hint=[r.from,r.to];cs('Hint: '+r.san);render()}
  else if(mode==='sq'){cs('Square is '+tsq.toUpperCase());flashOnce(tsq,'blunder');render()}
  else if(mode==='opening'){const op=currentOpening;if(!op)return;const nmv=nextBookMove(op,g.history());if(nmv)cs('Book move: '+nmv)}
  else if(mode==='mate'){if(over||busy)return;const r=pick(g,2).m;if(!r)return;hint=[r.from,r.to];cs('Hint: '+r.san);render()}

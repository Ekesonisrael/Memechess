const lastPick={};
function play(ev){
  const prof=({capp:'pawn',capn:'knight',capb:'bishop',capr:'rook',capq:'queen',mv:'move',ck:'check',pr:'promo',bl:'blunder',gr:'good'}[ev]||'move');
  const pool=PROFILES[prof]||PROFILES.move;let i,t=0;
  do{i=Math.random()*pool.length|0}while(pool.length>1&&i===lastPick[prof]&&t++<8);
  lastPick[prof]=i;pool[i]();
}

const FACE_TARGETS={
  idle:{bL:[24,34,32,28,42,32],bR:[58,32,68,28,76,34],eR:8,mouth:'M40 78 Q50 86 60 78',sweat:0,blush:0},

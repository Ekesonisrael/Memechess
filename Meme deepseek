let AC;const ac=()=>AC||(AC=new(window.AudioContext||window.webkitAudioContext)());
function tone(a,b,d,ty='sine',v=.3,t=0){try{const c=ac(),o=c.createOscillator(),n=c.createGain(),s=c.currentTime+t;o.type=ty;o.frequency.setValueAtTime(a,s);o.frequency.exponentialRampToValueAtTime(Math.max(b,1),s+d);n.gain.setValueAtTime(v,s);n.gain.exponentialRampToValueAtTime(.001,s+d);o.connect(n).connect(c.destination);o.start(s);o.stop(s+d)}catch(e){}}
function noise(d,v=.5,f=1000){try{const c=ac(),b=c.createBuffer(1,c.sampleRate*d,c.sampleRate),a=b.getChannelData(0);for(let i=0;i<a.length;i++)a[i]=(Math.random()*2-1)*(1-i/a.length);const s=c.createBufferSource(),fl=c.createBiquadFilter(),n=c.createGain();fl.frequency.value=f;n.gain.value=v;s.buffer=b;s.connect(fl).connect(n).connect(c.destination);s.start()}catch(e){}}
function speak(t,p){if(!$('#vo')||!$('#vo').checked||!window.speechSynthesis)return;try{speechSynthesis.cancel();const u=new SpeechSynthesisUtterance(String(t).replace(/[^\x00-\x7F]/g,''));u.pitch=p||.9;u.rate=1.08;speechSynthesis.speak(u)}catch(e){}}
const PROFILES={

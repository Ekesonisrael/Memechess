const faceState={key:'idle',t:0,blink:0,talking:0,bob:0};
let faceLast=performance.now(),faceRAF=null;
function setFace(k){faceState.key=FACE_TARGETS[k]?k:'idle'}
function faceTick(now){
  const dt=Math.min((now-faceLast)/1000,.05);faceLast=now;
  faceState.t+=dt;faceState.talking=Math.max(0,faceState.talking-dt);
  faceState.bob=Math.sin(faceState.t*2.2)*(faceState.talking>0?2.2:.7);
  faceState.blink=(faceState.blink+dt)%3.8;
  const root=document.querySelector('#face svg');
  if(root){
    const T=FACE_TARGETS[faceState.key]||FACE_TARGETS.idle;
    const bL=root.querySelector('#browL'),bR=root.querySelector('#browR'),
          eL=root.querySelector('#eyeL'),eR=root.querySelector('#eyeR'),
          mouth=root.querySelector('#mouth'),sw=root.querySelector('#sweat'),
          blL=root.querySelector('#blushL'),blR=root.querySelector('#blushR');
    bL.setAttribute('d',`M${T.bL[0]} ${T.bL[1]+faceState.bob} Q${T.bL[2]} ${T.bL[3]+faceState.bob} ${T.bL[4]} ${T.bL[5]+faceState.bob}`);
    bR.setAttribute('d',`M${T.bR[0]} ${T.bR[1]+faceState.bob} Q${T.bR[2]} ${T.bR[3]+faceState.bob} ${T.bR[4]} ${T.bR[5]+faceState.bob}`);
    mouth.setAttribute('d',T.mouth);
    mouth.setAttribute('transform',`translate(0 ${faceState.bob})`);
    const blinking=faceState.blink<0.12;
    const eyeScale=blinking?0.15:(1+Math.sin(faceState.t*1.7)*0.05);
    eL.setAttribute('ry',T.eR*eyeScale);eR.setAttribute('ry',T.eR*eyeScale);
    eL.setAttribute('cy',50+faceState.bob);eR.setAttribute('cy',50+faceState.bob);
    sw.setAttribute('opacity',T.sweat*(0.6+0.4*Math.sin(faceState.t*3)));
    blL.setAttribute('opacity',T.blush);blR.setAttribute('opacity',T.blush);
  }
  faceRAF=requestAnimationFrame(faceTick);
}
function startFaceLoop(){if(faceRAF)return;faceLast=performance.now();faceRAF=requestAnimationFrame(faceTick)}
function facePulse(){faceState.talking=1.2}

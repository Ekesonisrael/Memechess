function detectPattern(prevFen,newFen,mv,color){
  const after=new Chess(newFen);
  const board=after.board();
  let oppColor=color==='w'?'b':'w';
  let hanging=[];
  for(let r=0;r<8;r++)for(let c=0;c<8;c++){
    const p2=board[r][c];if(!p2||p2.color!==oppColor)continue;
    const sq='abcdefgh'[c]+(8-r);
    const attackers=after.moves({verbose:true}).filter(m=>m.to===sq&&m.color===color).length;
    const defenders=after.moves({verbose:true}).filter(m=>m.to===sq&&m.color===oppColor).length;
    if(attackers>defenders&&p2.type!=='k')hanging.push(sq+':'+p2.type);
  }
  return {hanging,isCap:!!mv.captured,isCheck:after.in_check()};
}

